# Copy to .env (or set these in your host's dashboard). Everything here is optional
# except in production, where APP_URL and DATABASE_PATH should be set.

# Public address of the site, used in alert links and the form address
APP_URL=https://commandhub.example.com
# Where the database file lives (put it on a persistent disk)
DATABASE_PATH=./data/commandhub.db
NODE_ENV=production

# Text alerts (Twilio): https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+18645550100

# Email alerts (Resend): https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Command Hub <alerts@yourdomain.com>
